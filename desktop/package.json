{
  "name": "dioptas-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend:build": "cargo build --locked --manifest-path backend/Cargo.toml",
    "backend:build:dioptrin": "cargo build --locked --manifest-path backend/Cargo.toml --features dioptrin",
    "backend:test": "cargo test --locked --manifest-path backend/Cargo.toml --all-features",
    "test:native-backend": "node scripts/native_backend_smoke.mjs",
    "test:native-calibration": "node scripts/native_calibration_smoke.mjs",
    "test:native-calibration-transport": "node --test scripts/native_calibration_transport.test.mjs",
    "test:native-mask": "node scripts/native_mask_smoke.mjs",
    "test:native-mask-transport": "node --test scripts/native_mask_transport.test.mjs",
    "tauri:native-dev": "tauri dev --config src-tauri/tauri.native-dev.conf.json -- -- --backend=rust",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:phase-dev": "tauri dev --config src-tauri/tauri.phase-dev.conf.json -- -- --example",
    "tauri:build": "tauri build --no-bundle",
    "tauri:smoke": "node scripts/tauri_smoke.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src 'scripts/*.{mjs,js}' vite.config.ts src-tauri/*.json src-tauri/capabilities/*.json",
    "test": "node --test scripts/overlay_color_scales.test.mjs scripts/plot_ticks.test.mjs scripts/raster_transfer.test.mjs scripts/phase_line_scaling.test.mjs scripts/readout_numbers.test.mjs scripts/radial_readout.test.mjs scripts/pattern_samples.test.mjs scripts/phase_command_queue.test.mjs scripts/phase_author_search.test.mjs scripts/prepare_detector_image.test.mjs scripts/map_pattern.test.mjs scripts/linked_position.test.mjs scripts/plot_viewport.test.mjs scripts/batch_display.test.mjs",
    "test:detector-redraw": "node scripts/detector_redraw_smoke.mjs",
    "test:rendering": "node scripts/rendering_smoke.mjs",
    "test:integration-processing": "node scripts/integration_processing_smoke.mjs",
    "test:custom-commands": "node scripts/custom_commands_smoke.mjs",
    "benchmark:pattern": "node scripts/pattern_benchmark.mjs",
    "benchmark:pattern:native": "node scripts/pattern_native_benchmark.mjs",
    "test:pattern-quality": "node scripts/pattern_quality.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
