{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "The local Dioptas window may call the bounded scientific command interface.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-desktop-invoke",
    "allow-session-recovery",
    "allow-prepare-color-picker",
    "allow-show-calibration-tooltip",
    "allow-hide-calibration-tooltip",
    "allow-native-smoke-report",
    "core:window:allow-title",
    "core:window:allow-set-title",
    "allow-open-phase-editor",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "allow-open-map-window",
    "allow-close-map-window",
    "allow-open-batch-window",
    "allow-close-batch-window",
    "allow-open-detector-window",
    "allow-close-detector-window",
    "allow-publish-detector-snapshot",
    "core:event:allow-emit-to",
    "allow-open-peritheos-manual"
  ]
}
